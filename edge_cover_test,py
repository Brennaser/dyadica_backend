weights = [[np.nan, np.nan, 3, np.nan, 1, 2],
           [np.nan, np.nan, 4, np.nan, 3, 4],
           [ 3,  4, np.nan, 2, 2, 3],
           [np.nan, np.nan, 2, np.nan, 4, 1],
           [ 1, 3, 2, 4, np.nan, np.nan],
           [ 2, 4, 3, 1, np.nan, np.nan],]

# weights = np.array(weights) # TODO: normalize
weights = pd.DataFrame(weights)
weights = (weights - weights.min().min()) / (weights.max().max() - weights.min().min())

weights.index = ['one', 'two', 'three', 'four', 'five', 'six']
weights.columns = ['one', 'two', 'three', 'four', 'five', 'six']

original_weights = weights.copy()

for i in range(10):
    print(f"Round {i + 1}:")
    pairs = edge_cover(weights)

    [print(f"\t{a}\t{b}") for a, b in pairs]

    adjust_weights(pairs, weights, original_weights)




